{
  "permissions": {
    "allow": [
      "WebFetch(domain:localhost)",
      "PowerShell(try { $r = Invoke-WebRequest -Uri \"http://localhost:5022\" -UseBasicParsing -TimeoutSec 5; \"Status: $\\($r.StatusCode\\)\" } catch { \"Error: $_\" })",
      "PowerShell(try { $r = Invoke-WebRequest -Uri \"http://localhost:5022/app\" -UseBasicParsing -TimeoutSec 5; \"Status: $\\($r.StatusCode\\), Length: $\\($r.Content.Length\\)\" } catch { \"Error: $_\" })",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ]
  }
}
